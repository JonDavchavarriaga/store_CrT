# ==============================================================================
# CHICA ROSA - VARIABLES DE ENTORNO PÚBLICAS (FRONTEND)
# ==============================================================================
# IMPORTANTE:
# - Las variables con prefijo VITE_ se empaquetan en el bundle del navegador.
# - NUNCA coloques service_role, contraseñas ni claves secretas aquí.
# - Para desarrollo local, copia este archivo como .env y rellena tus credenciales.
# ==============================================================================

# Supabase (Proyecto de Base de Datos y Autenticación)
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Parámetros Comerciales
# Número internacional de WhatsApp (solo dígitos, sin +, sin espacios ni guiones)
# Ejemplo para Colombia (código país 57 + celular de 10 dígitos = 12 dígitos en total): 573114677311
VITE_WHATSAPP_NUMBER=573114677311

# Nombre público de la tienda
VITE_STORE_NAME="Chica Rosa Tienda"

# Moneda oficial (COP)
VITE_STORE_CURRENCY=COP
